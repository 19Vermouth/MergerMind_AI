# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=dealsense
POSTGRES_USER=dealsense_user
POSTGRES_PASSWORD=changeme_change_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# =============================================================================
# MINIO (S3-Compatible Data Lake)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_in_production
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_RAW=dealsense-raw
MINIO_BUCKET_PROCESSED=dealsense-processed
MINIO_BUCKET_MODELS=dealsense-models

# =============================================================================
# AIRFLOW
# =============================================================================
AIRFLOW_VERSION=2.9.1
AIRFLOW_UID=50000
AIRFLOW_EXECUTOR=LocalExecutor
_AIRFLOW_SECRET_KEY=your_secret_key_here_change_in_production

# =============================================================================
# MLFLOW
# =============================================================================
MLFLOW_TRACKING_URI=http://mlflow:5001
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# =============================================================================
# API KEYS
# =============================================================================
# NewsAPI - https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Groq (Primary LLM - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (Fallback LLM - https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini (Fallback LLM - https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional - for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# MONTE CARLO SETTINGS
# =============================================================================
MONTE_CARLO_SIMULATIONS=50000
SIMULATION_SEED=42

# =============================================================================
# SCRAPING SETTINGS
# =============================================================================
SCRAPY_CONCURRENT_REQUESTS=1
SCRAPY_DOWNLOAD_DELAY=1

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
MODEL_WEIGHT_ML=0.35
MODEL_WEIGHT_SENTIMENT=0.25
MODEL_WEIGHT_SIMULATION=0.40

# LLM Configuration
LLM_PRIMARY_PROVIDER=groq
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000